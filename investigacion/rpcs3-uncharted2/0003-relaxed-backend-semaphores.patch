diff --git a/rpcs3/Emu/RSX/NV47/HW/nv4097.cpp b/rpcs3/Emu/RSX/NV47/HW/nv4097.cpp
index 313daf1..58a378d 100644
--- a/rpcs3/Emu/RSX/NV47/HW/nv4097.cpp
+++ b/rpcs3/Emu/RSX/NV47/HW/nv4097.cpp
@@ -786,6 +786,15 @@ namespace rsx
 			}
 
 			const u32 val = (arg & 0xff00ff00) | ((arg & 0xff) << 16) | ((arg >> 16) & 0xff);
+
+			if (g_cfg.video.relaxed_backend_semaphores && !g_cfg.video.strict_rendering_mode) [[ unlikely ]]
+			{
+				// Without host GPU labels (e.g. MoltenVK) every release is a full GPU sync. Games that poll these labels
+				// from SPU/PPU every frame (Uncharted 2) end up waiting on the host GPU constantly. Only flush DMA.
+				util::write_gcm_label<true, false>(ctx, reg, addr, val);
+				return;
+			}
+
 			util::write_gcm_label<true, true>(ctx, reg, addr, val);
 		}
 
