diff --git a/rpcs3/Emu/RSX/NV47/HW/nv406e.cpp b/rpcs3/Emu/RSX/NV47/HW/nv406e.cpp
index fd8ec80..130167e 100644
--- a/rpcs3/Emu/RSX/NV47/HW/nv406e.cpp
+++ b/rpcs3/Emu/RSX/NV47/HW/nv406e.cpp
@@ -13,7 +13,12 @@ namespace rsx
 	{
 		void set_reference(context* ctx, u32 /*reg*/, u32 arg)
 		{
-			RSX(ctx)->sync();
+			// U2M4: on MoltenVK a full sync here takes long enough for games that poll the reference (Uncharted 2 "RsxKick")
+			// to time out and then double-count the late completion ("[SPU-PM] too many flags").
+			if (!g_cfg.video.relaxed_406e_sync || g_cfg.video.strict_rendering_mode)
+			{
+				RSX(ctx)->sync();
+			}
 
 			// Write ref+get (get will be written again with the same value at command end)
 			auto& dma = *vm::_ptr<RsxDmaControl>(RSX(ctx)->dma_address);
@@ -134,6 +139,13 @@ namespace rsx
 				arg = 1;
 			}
 
+			if (g_cfg.video.relaxed_406e_sync && !g_cfg.video.strict_rendering_mode) [[ unlikely ]]
+			{
+				// See set_reference: publish the label as soon as the RSX thread reaches it
+				util::write_gcm_label<false, false>(ctx, reg, addr, arg);
+				return;
+			}
+
 			util::write_gcm_label<false, true>(ctx, reg, addr, arg);
 		}
 	}
