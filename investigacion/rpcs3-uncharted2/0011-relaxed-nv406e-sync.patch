 		cfg::_enum<framebuffer_aliasing_bias> fb_aliasing_bias{ this, "Framebuffer Aliasing Heuristic Bias", framebuffer_aliasing_bias::_auto, true };
 		cfg::_bool disable_zcull_queries{ this, "Disable ZCull Occlusion Queries", false, true };
 		cfg::uint<0, 0xffffff> zcull_fake_zpass_value{ this, "ZCull Fake ZPass Value", 0, true }; // With queries disabled, report this many passing pixels instead of 0 (0 = off)
+		cfg::_bool relaxed_406e_sync{ this, "Relaxed NV406E Sync", false, true }; // NV406E semaphore release / set reference without a full host GPU sync (MoltenVK latency trips guest timeouts)
 		cfg::_bool relaxed_backend_semaphores{ this, "Relaxed Back-End Semaphores", false, true }; // Write back-end semaphore labels without a full GPU pipeline sync
 		cfg::_bool disable_video_output{ this, "Disable Video Output", false, true };
 		cfg::_bool disable_vertex_cache{ this, "Disable Vertex Cache", false };
