diff --git a/rpcs3/Emu/RSX/VK/VKShaderInterpreter.cpp b/rpcs3/Emu/RSX/VK/VKShaderInterpreter.cpp
index 9ef7491..e836561 100644
--- a/rpcs3/Emu/RSX/VK/VKShaderInterpreter.cpp
+++ b/rpcs3/Emu/RSX/VK/VKShaderInterpreter.cpp
@@ -1,6 +1,7 @@
 #include "stdafx.h"
 
 #include "VKShaderInterpreter.h"
+#include "Emu/system_config.h"
 #include "VKVertexProgram.h"
 #include "VKFragmentProgram.h"
 #include "VKHelpers.h"
@@ -611,6 +612,13 @@ namespace vk
 			{
 				m_current_interpreter = found->second.program;
 
+				if (!m_current_interpreter)
+				{
+					// U2M4: background link still in flight, skip this draw and look again next time
+					m_current_key = {};
+					return nullptr;
+				}
+
 				if ((found->second.flags & (CACHED_PIPE_UNOPTIMIZED | CACHED_PIPE_RECOMPILING)) == CACHED_PIPE_UNOPTIMIZED)
 				{
 					found->second.flags |= CACHED_PIPE_RECOMPILING;
@@ -621,6 +629,22 @@ namespace vk
 			}
 		}
 
+		if (g_cfg.video.async_interpreter_link)
+		{
+			// U2M4: a synchronous link here blocks the RSX thread for hundreds of ms on MoltenVK (huge interpreter shaders
+			// -> Metal pipeline compile). Uncharted 2's RsxKick watchdog (~0.3 s) fires and its SPU job manager desyncs.
+			// Link in the background with a null placeholder; draws using this state are skipped until it lands.
+			{
+				std::lock_guard lock(m_program_cache_lock);
+				m_program_cache[key] = pipeline_cache_entry_t{ .flags = CACHED_PIPE_RECOMPILING, .program = nullptr };
+			}
+
+			link(properties, key.compiler_opt, true, {});
+			m_current_interpreter = nullptr;
+			m_current_key = {};
+			return nullptr;
+		}
+
 		const auto start = std::chrono::steady_clock::now();
 
 		m_current_interpreter = link(properties, key.compiler_opt);
